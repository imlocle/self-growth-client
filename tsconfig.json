{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@auth/*": ["src/auth/*"],
      "@core/*": ["src/core/*"],
      "@domain/*": ["src/domain/*"],
      "@features/*": ["src/features/*"],
      "@navigation/*": ["src/navigation/*"],
      "@scope/*": ["src/scope/*"],
      "@screens/*": ["src/screens/*"],
      "@ui/*": ["src/ui/*"]
    }
  }
}
